{
	// container for running Kenning
	"name": "AutoML",
	"build": {
		"context": "../..",
		"dockerfile": "Dockerfile"
	},
	"customizations": {
		"vscode": {
			"extensions": ["AnalogDevices.automl-embedded"]
		}
	},
	"containerEnv": {
		"PYRENODE_PKG": "/opt/renode/renode-latest.pkg.tar.gz"
	},
	"runArgs": [
		"--device", "/dev/ttyUSB0",
        "--device", "/dev/ttyACM0",
        "--privileged"
    ]
}